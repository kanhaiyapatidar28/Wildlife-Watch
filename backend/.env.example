# Wildlife Watch - Backend Environment Configuration
PROJECT_NAME="Wildlife Watch API"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Secret Key for JWT & Security
SECRET_KEY="wildlife-watch-development-secret-key-change-in-production"

# PostgreSQL / PostGIS Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wildlife_watch"
DB_ECHO=False

# Google Earth Engine (GEE) Configuration
# Leave unset or empty to use local fallback mode
EE_PROJECT_ID="your-gcp-project-id"
EE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-gcp-project-id.iam.gserviceaccount.com"
# Specify either private key path or raw private key json
EE_PRIVATE_KEY_PATH="credentials/gee-key.json"
# EE_PRIVATE_KEY_JSON='{"type": "service_account", ...}'
EE_CACHE_TTL_SECONDS=3600
EE_DEFAULT_MAX_CLOUD_PERCENT=20.0
EE_DEFAULT_RESOLUTION_METERS=20


